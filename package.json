{
  "name": "@local/dsh-plugin-todo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "待办与日程面板：农历/节气、AI 抽取、列表与日历双视图",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --loader:.css=text --minify --target=es2020 --outfile=client.js"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "lib",
    "data",
    "locale",
    "docs",
    "icon.svg",
    "LICENSE"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
